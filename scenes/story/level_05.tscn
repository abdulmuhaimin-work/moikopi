[node name="Cinematic1" parent="." instance=ExtResource("6_cutscene")]
position = Vector2(200, 155)
cutscene_text = "The apex. The air is thin and bright. Everything below you is noise. Everything above is silence."
display_duration = 3.5
mode = 1

[node name="Ambient1" parent="." instance=ExtResource("6_cutscene")]
position = Vector2(100, -98)
cutscene_text = "Your body remembers being something else. Before the Stack."
display_duration = 4.5

[node name="Cinematic2" parent="." instance=ExtResource("6_cutscene")]
position = Vector2(320, -170)
cutscene_text = "The ones who built this place left a question at the top. They never came back to hear the answer."
display_duration = 3.5
mode = 1

[node name="Ambient2" parent="." instance=ExtResource("6_cutscene")]
position = Vector2(540, -344)
cutscene_text = "The platforms are thinning. The Stack is letting go of you."
display_duration = 4.0

[node name="Cinematic3" parent="." instance=ExtResource("6_cutscene")]
position = Vector2(320, -394)
cutscene_text = "You were never climbing to escape. You were climbing to remember."
display_duration = 3.0
mode = 1

[node name="Ambient3" parent="." instance=ExtResource("6_cutscene")]
position = Vector2(120, -470)
cutscene_text = "The signal is so clear now it almost sounds like your own name."
display_duration = 4.5

[node name="Ambient4" parent="." instance=ExtResource("6_cutscene")]
position = Vector2(120, -544)
cutscene_text = "One more jump. You already know what's up there."
display_duration = 3.5

[node name="Cinematic4" parent="." instance=ExtResource("6_cutscene")]
position = Vector2(320, -700)
cutscene_text = "Moikopi. That is your name. The Stack didn't trap you. It kept you safe until you were ready to leave."
display_duration = 5.0
mode = 1

